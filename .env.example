# Bestar Construction - Environment Variables Configuration

# Optional: Email notification integration via Resend (https://resend.com)
# When set, submissions through the quotation form will automatically trigger an email notification.
RESEND_API_KEY=re_your_api_key_here

# Notification recipient email address (defaults to bestarconstructioninfo@gmail.com if omitted)
CONTACT_NOTIFICATION_EMAIL=bestarconstructioninfo@gmail.com

# Base URL for metadata / OpenGraph resolution (optional in development)
NEXT_PUBLIC_SITE_URL=https://bestarconstruction.com
